# Nightjar configuration. Copy to .env and edit. Never commit .env.
#
# Every variable is optional; the defaults run the local demo with the synthetic
# lab and the deterministic mock runtime.

# --- runtime -----------------------------------------------------------------
NIGHTJAR_ENVIRONMENT=development
NIGHTJAR_LOG_LEVEL=INFO
NIGHTJAR_API_HOST=127.0.0.1
NIGHTJAR_API_PORT=8000

# Set a long random value before exposing the API. Empty disables auth.
NIGHTJAR_API_TOKEN=

# Comma-separated browser origins allowed to call the API.
NIGHTJAR_CORS_ORIGINS=http://127.0.0.1:3000

# --- database ----------------------------------------------------------------
NIGHTJAR_DATABASE_URL=postgresql+asyncpg://nightjar:nightjar@127.0.0.1:55432/nightjar

# --- orchestration -----------------------------------------------------------
# inline (default) or temporal
NIGHTJAR_ORCHESTRATOR=inline
NIGHTJAR_TEMPORAL_ADDRESS=127.0.0.1:7233
NIGHTJAR_TEMPORAL_NAMESPACE=default
NIGHTJAR_TEMPORAL_TASK_QUEUE=nightjar
NIGHTJAR_STABILITY_SECONDS=900
NIGHTJAR_APPROVAL_TTL_SECONDS=1800

# --- policy ------------------------------------------------------------------
# Leave empty for the local engine. Set to use a remote OPA server.
NIGHTJAR_OPA_URL=

# --- probes ------------------------------------------------------------------
# Must be false in production. true is only for the synthetic lab.
NIGHTJAR_ALLOW_PRIVATE_PROBES=true
NIGHTJAR_LAB_ENABLED=true
NIGHTJAR_LAB_BASE_URL=http://127.0.0.1:8100

# --- model provider ----------------------------------------------------------
# mock | openai | anthropic | google | ollama
NIGHTJAR_MODEL_PROVIDER=mock
NIGHTJAR_MODEL_NAME=rules-v1
NIGHTJAR_MODEL_API_KEY=
NIGHTJAR_MODEL_BASE_URL=
NIGHTJAR_CRITIC_PROVIDER=mock
NIGHTJAR_CRITIC_MODEL_NAME=rules-v1
NIGHTJAR_CRITIC_API_KEY=
NIGHTJAR_CRITIC_BASE_URL=

NIGHTJAR_MAX_INVESTIGATION_TOOL_CALLS=20
NIGHTJAR_MAX_INVESTIGATION_SECONDS=360
NIGHTJAR_MAX_COST_USD=0.75

# --- connectors --------------------------------------------------------------
NIGHTJAR_GITHUB_TOKEN=
NIGHTJAR_GITHUB_API_URL=https://api.github.com
NIGHTJAR_CLOUDFLARE_TOKEN=
NIGHTJAR_CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
NIGHTJAR_NOTIFY_WEBHOOK_URL=

# --- telemetry ---------------------------------------------------------------
NIGHTJAR_OTEL_ENABLED=false
NIGHTJAR_OTEL_ENDPOINT=
