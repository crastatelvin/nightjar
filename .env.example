# Nightjar configuration. Copy to .env and edit. Never commit .env.
#
# Every variable is optional; the defaults run the local demo with the synthetic
# lab and the deterministic mock runtime.

# --- runtime -----------------------------------------------------------------
NIGHTJAR_ENVIRONMENT=development
NIGHTJAR_LOG_LEVEL=INFO
NIGHTJAR_API_HOST=127.0.0.1
NIGHTJAR_API_PORT=8000

# Set a long random value before exposing the API. Empty disables auth.
NIGHTJAR_API_TOKEN=

# OIDC replaces the static token when set (issuer must publish a JWKS).
# The audience is mandatory: an issuer with no audience check accepts tokens
# minted for any other application on the same issuer.
NIGHTJAR_OIDC_ISSUER=
NIGHTJAR_OIDC_AUDIENCE=
NIGHTJAR_OIDC_GROUPS_CLAIM=groups
# Groups whose members may approve R2 actions and attest manual steps. Requires
# OIDC: the shared token has no group claim, so it cannot satisfy this. Empty
# means any authenticated caller may approve.
NIGHTJAR_OIDC_APPROVER_GROUPS=
# Refuse approvals from the operator who filed the incident. Off by default so a
# one-person operations team is not locked out; turn it on once there are two.
NIGHTJAR_REQUIRE_SEPARATION_OF_DUTIES=false

# Comma-separated browser origins allowed to call the API (a JSON list also works).
NIGHTJAR_CORS_ORIGINS=http://127.0.0.1:3000

# --- API protection ----------------------------------------------------------
# Every response carries x-request-id. Each caller gets a token bucket; over
# budget is 429 with Retry-After. Callers are keyed by address, charged before
# auth. `memory` keeps the bucket per process, so N replicas allow N times this
# budget; use `database` for more than one replica and the number becomes real.
NIGHTJAR_API_RATE_LIMIT_ENABLED=true
NIGHTJAR_API_RATE_LIMIT_PER_MINUTE=120
NIGHTJAR_API_RATE_LIMIT_BURST=60
NIGHTJAR_API_RATE_LIMIT_BACKEND=memory
# Only enable when a proxy you control sets X-Forwarded-For; otherwise a caller
# chooses its own address and its own budget.
NIGHTJAR_API_TRUST_FORWARDED_FOR=false
# Largest request body accepted anywhere. The signed intake has a smaller cap.
NIGHTJAR_API_MAX_BODY_BYTES=1048576

# Case-file streams wake on PostgreSQL LISTEN/NOTIFY. Turn notifications off to
# run without the extra connection; streams then poll every NIGHTJAR_SSE_POLL_SECONDS.
NIGHTJAR_SSE_NOTIFY_ENABLED=true
NIGHTJAR_SSE_POLL_SECONDS=5

# --- web UI (server-side demo proxy) -----------------------------------------
# Read by apps/web, not by the Python API. Compose sets these to the service names.
NIGHTJAR_API_URL=http://127.0.0.1:8000
NIGHTJAR_LAB_URL=http://127.0.0.1:8100

# --- database ----------------------------------------------------------------
NIGHTJAR_DATABASE_URL=postgresql+asyncpg://nightjar:nightjar@127.0.0.1:55432/nightjar
NIGHTJAR_DB_ECHO=false
# Advisory locks make two API replicas safe. Keep true outside single-process dev.
NIGHTJAR_DB_LOCKS=true

# --- orchestration -----------------------------------------------------------
# inline (default) or temporal
NIGHTJAR_ORCHESTRATOR=inline
NIGHTJAR_TEMPORAL_ADDRESS=127.0.0.1:7233
NIGHTJAR_TEMPORAL_NAMESPACE=default
NIGHTJAR_TEMPORAL_TASK_QUEUE=nightjar
# How long a fix must hold before resolution. 900s is the production default;
# the compose demo sets 30s so a run completes while you watch.
NIGHTJAR_STABILITY_SECONDS=900
NIGHTJAR_APPROVAL_TTL_SECONDS=1800
# A connector call is retried only when repeating it cannot duplicate a mutation,
# and never waits longer than this even when the provider asks for more.
NIGHTJAR_CONNECTOR_MAX_ATTEMPTS=3
NIGHTJAR_CONNECTOR_RETRY_MAX_WAIT_SECONDS=30

# --- policy ------------------------------------------------------------------
# Leave empty for the local engine. Set to use a remote OPA server.
NIGHTJAR_OPA_URL=

# --- probes ------------------------------------------------------------------
# Must be false in production. true is only for the synthetic lab.
NIGHTJAR_ALLOW_PRIVATE_PROBES=true
NIGHTJAR_LAB_ENABLED=true
NIGHTJAR_LAB_BASE_URL=http://127.0.0.1:8100

# --- model provider ----------------------------------------------------------
# mock | openai | anthropic | google | ollama
NIGHTJAR_MODEL_PROVIDER=mock
NIGHTJAR_MODEL_NAME=rules-v1
NIGHTJAR_MODEL_API_KEY=
NIGHTJAR_MODEL_BASE_URL=
NIGHTJAR_CRITIC_PROVIDER=mock
NIGHTJAR_CRITIC_MODEL_NAME=rules-v1
NIGHTJAR_CRITIC_API_KEY=
NIGHTJAR_CRITIC_BASE_URL=

NIGHTJAR_MAX_INVESTIGATION_TOOL_CALLS=20
NIGHTJAR_MAX_INVESTIGATION_SECONDS=360
NIGHTJAR_MAX_COST_USD=0.75

# --- connectors --------------------------------------------------------------
NIGHTJAR_GITHUB_TOKEN=
NIGHTJAR_GITHUB_API_URL=https://api.github.com
NIGHTJAR_GITHUB_ORG=
# Enable the unauthenticated token-revocation action even without an issue token.
NIGHTJAR_GITHUB_CREDENTIAL_REVOCATION=false
NIGHTJAR_CLOUDFLARE_TOKEN=
NIGHTJAR_CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
# Needed only for Cloudflare Pages rollback (rollback_deployment).
NIGHTJAR_CLOUDFLARE_ACCOUNT_ID=
NIGHTJAR_CLOUDFLARE_PAGES_PROJECT=
# Gmail quarantine and sender blocking via a service account with domain-wide
# delegation. The key file stays on disk; Nightjar only reads it at execution
# time. Managed mailboxes are required (see below).
NIGHTJAR_GOOGLE_SERVICE_ACCOUNT_FILE=
NIGHTJAR_GOOGLE_API_URL=https://gmail.googleapis.com
NIGHTJAR_GOOGLE_OAUTH_URL=https://oauth2.googleapis.com/token
NIGHTJAR_GOOGLE_QUARANTINE_LABEL=Nightjar-Quarantine
# Microsoft 365 through an Entra app with application permissions and admin
# consent: Mail.ReadWrite, MailboxSettings.ReadWrite, and
# User.RevokeSessions.All. Scope the app to the managed mailboxes with an
# application access policy. Session verification also needs AuditLog.Read.All
# and Entra ID P1; without them Nightjar cannot prove the revocation.
NIGHTJAR_MICROSOFT_TENANT_ID=
NIGHTJAR_MICROSOFT_CLIENT_ID=
NIGHTJAR_MICROSOFT_CLIENT_SECRET=
NIGHTJAR_MICROSOFT_GRAPH_URL=https://graph.microsoft.com/v1.0
NIGHTJAR_MICROSOFT_LOGIN_URL=https://login.microsoftonline.com
NIGHTJAR_MICROSOFT_QUARANTINE_FOLDER=Nightjar Quarantine
# Graph's eventual consistency window before a sign-in is treated as post-revocation.
NIGHTJAR_MICROSOFT_PROPAGATION_SECONDS=180
NIGHTJAR_VERCEL_TOKEN=
NIGHTJAR_VERCEL_API_URL=https://api.vercel.com
NIGHTJAR_VERCEL_TEAM_ID=
NIGHTJAR_VERCEL_PROJECT=
NIGHTJAR_RENDER_API_KEY=
NIGHTJAR_RENDER_API_URL=https://api.render.com/v1
NIGHTJAR_RENDER_SERVICE_ID=
# Machine restart. The app is the managed target; the machine is chosen per
# incident (list them with the fly.machines tool).
NIGHTJAR_FLY_API_TOKEN=
NIGHTJAR_FLY_API_URL=https://api.machines.dev
NIGHTJAR_FLY_APP=
# Stripe has no API to expire a key. When a read-only key is configured,
# Nightjar surfaces the Dashboard step and proves the exposed key is dead with a
# 401 probe; the exposed key itself comes from the incident's vault reference.
NIGHTJAR_STRIPE_SECRET_KEY=
NIGHTJAR_STRIPE_API_URL=https://api.stripe.com
NIGHTJAR_NOTIFY_WEBHOOK_URL=
# When set, outbound notifications carry an HMAC-SHA256 signature header.
NIGHTJAR_NOTIFY_WEBHOOK_SECRET=

# --- inbound intake ---------------------------------------------------------
# Alert sources file incidents by POSTing to /v1/intake/webhook. The request is
# authenticated by a shared secret instead of a bearer token: sign the exact
# bytes "<unix timestamp>.<body>" with HMAC-SHA256 and send
#   x-nightjar-signature: t=<timestamp>,v1=<hex digest>
# Optionally send x-nightjar-delivery: <id>; a repeated id is rejected with 409.
# Leave the secret empty to disable the endpoint (503). Production refuses a
# secret shorter than 32 characters.
NIGHTJAR_INTAKE_WEBHOOK_SECRET=
NIGHTJAR_INTAKE_WEBHOOK_TOLERANCE_SECONDS=300
NIGHTJAR_INTAKE_MAX_BODY_BYTES=65536

# --- managed targets ---------------------------------------------------------
# Targets the agent may touch, as JSON keyed by provider. Policy denies any
# action outside this list, so a prompt-injected plan cannot name its own zone,
# repository, mailbox, project, or app. Required when NIGHTJAR_ENVIRONMENT=production.
# Example:
# NIGHTJAR_MANAGED_TARGETS={"cloudflare":{"zones":["abc123"]},"github":{"repos":["acme/site"],"orgs":["acme"]},"google":{"mailboxes":["owner@acme.example"]},"microsoft":{"mailboxes":["owner@acme.example"]}}
NIGHTJAR_MANAGED_TARGETS=

# --- secrets ----------------------------------------------------------------
# Connector credentials are referenced, never inlined: action parameters carry
# env:NAME or file:/path, and the value is read only at execution time. The
# database, the timeline, and the model prompt never see the raw value.
# Put the credential in this process's environment, not in this file:
#   export EXPOSED_GITHUB_PAT=ghp_...

# --- telemetry ---------------------------------------------------------------
# Traces and metrics are optional and off by default. Enabling them without the
# endpoint is refused at startup rather than exporting to a default that reaches
# nowhere. Install the extra first: uv sync --extra otel
# See docs/observability.md.
NIGHTJAR_OTEL_ENABLED=false
NIGHTJAR_OTEL_ENDPOINT=
NIGHTJAR_OTEL_SERVICE_NAME=nightjar
# 1.0 keeps every trace; lower it only when export volume is a problem.
NIGHTJAR_OTEL_SAMPLE_RATIO=1.0
